# Development environment
# Use a dedicated PostgreSQL/Neon development database. Do not use production data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-long-random-development-secret

# Optional app/public URL settings
# APP_BASE_URL=http://localhost:5000
# PUBLIC_INVITE_BASE_URL=http://localhost:5000
# VITE_PUBLIC_INVITE_BASE_URL=http://localhost:5000
# VITE_API_URL=http://localhost:5000

# Optional email/OAuth settings for invite sending flows
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_BASE_URL=
# ZOHO_MAIL_API_BASE_URL=
# ZOHO_OAUTH_REDIRECT_URI=
# EMAIL_TOKEN_ENCRYPTION_KEY=
